# ============================================================
# promptOptimizer — Docker Compose (.env)
# From this folder: docker compose up --build
# ============================================================

# --- Postgres container ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=jetpromptoptimizer
POSTGRES_PORT=5432

# Used when running API locally (host machine). Compose overrides this for the app container.
DATABASE_URL=postgresql://postgres:change_me_in_production@localhost:5432/jetpromptoptimizer

# --- API ---
APP_PORT=8000
FRONTEND_URL=http://localhost:3000
ENVIRONMENT=production

# --- Redis ---
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379

# --- OpenAI / vector ---
OPENAI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
PINECONE_ENVIRONMENT=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_ESSENTIAL=
STRIPE_PRICE_ID_PRO=
AFFILIATE_CODES=

# --- Context Jobs ---
KEY_ENCRYPTION_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
CODE_EXEC_DOCKER_IMAGE=python:3.11-alpine
RUN_ARTIFACT_ROOT=data/run-artifacts
MAX_RUN_WORKERS=2
MAX_RUN_QUEUE=50
MAX_AGENT_TURNS_DEFAULT=10

# --- Firebase (set JSON for Docker; or place firebase-service-account.json locally) ---
FIREBASE_PROJECT_ID=
# Optional: paste service account JSON as one line for Docker (preferred over file mount)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json
