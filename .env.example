# ============================================
# DATABASE CONFIGURATION
# ============================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=promptoptimizer_db
DB_PORT=5432

# ============================================
# DATABASE CONNECTION STRING
# ============================================
DATABASE_URL=postgresql://postgres:change_me_in_production@db:5432/promptoptimizer_db

# ============================================
# OPENAI CONFIGURATION
# ============================================
OPENAI_API_KEY=your_openai_api_key_here

# ============================================
# PINECONE CONFIGURATION
# ============================================
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=your_index_name

# ============================================
# STRIPE CONFIGURATION
# ============================================
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
STRIPE_PRICE_ID_ESSENTIAL=price_essential_id_here
STRIPE_PRICE_ID_PRO=price_pro_id_here

# ============================================
# FRONTEND CONFIGURATION
# ============================================
FRONTEND_URL=http://localhost:3000

# ============================================
# APPLICATION CONFIGURATION
# ============================================
ENVIRONMENT=production
APP_PORT=8000

# ============================================
# REDIS CONFIGURATION (Optional)
# ============================================
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379

# ============================================
# FIREBASE CONFIGURATION (Optional)
# ============================================
# Ensure firebase-service-account.json is in the app directory
FIREBASE_PROJECT_ID=your_firebase_project_id

# ============================================
# CONTEXT JOBS ORCHESTRATION
# ============================================
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LLM_KEY_ENCRYPTION_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
CODE_EXEC_DOCKER_IMAGE=python:3.11-alpine
RUN_ARTIFACT_ROOT=data/run-artifacts
MAX_RUN_WORKERS=2
MAX_RUN_QUEUE=50
MAX_AGENT_TURNS_DEFAULT=10
